{
  "name": "gym_admin",
  "version": "1.3.0",
  "description": "Gym membership management application",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "repository": "https://github.com/Yassine24talbi/gym_admin",
  "publish": {
    "provider":"github",
    "releaseType":"release"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.7.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gymadmin.app",
    "productName": "Gym Admin",
    "directories": {
      "output": "App"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Yassine24talbi",
      "repo": "gym_admin"
    }
  }
}
